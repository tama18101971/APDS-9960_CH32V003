.pio

# PlatformIO compilation database for clangd (pio run -t compiledb).
# Contains absolute paths of the machine that generated it (home directory,
# PlatformIO packages dir), so it must never be committed.
compile_commands.json

# clangd background index and logs (default index dir: <workspace>/.cache).
.cache

# Machine-local editor settings: holds the per-machine clangd settings
# (e.g. "clangd.arguments" with an absolute --query-driver path).
.vscode/settings.json

# Microsoft C/C++ (cpptools) leftovers from the PlatformIO IntelliSense setup.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
